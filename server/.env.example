PORT=5000

# Supabase PostgreSQL — Get from Supabase Dashboard → Connect → Direct → Transaction pooler
# Replace [YOUR-PASSWORD] with your DB password (URL-encode special chars: @ → %40)
DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-1-ap-south-1.pooler.supabase.com:6543/postgres

JWT_SECRET=change_this_to_a_random_string
